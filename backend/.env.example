# NIRF Analytics Dashboard — Environment Configuration

PROJECT_NAME="NIRF Analytics Dashboard"
VERSION="1.0.0"
ENVIRONMENT="development"
DEBUG=true
LOG_LEVEL="INFO"

# Server Configuration
HOST="0.0.0.0"
PORT=8000

# CORS Configuration (comma-separated origins or JSON array)
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:3000","http://127.0.0.1:3000"]

# Dataset Path (optional override, otherwise defaults to data/Processed/NIRF_Master_Dataset.csv)
# MASTER_DATASET_PATH="C:/Users/lodha/Downloads/NIRF_DASHBOARD/data/Processed/NIRF_Master_Dataset.csv"

# ------------------------------------------------------------------------------
# External LLM Provider Configuration (Secondary AI Engine)
# Supports: openai, gemini, anthropic, openrouter, ollama, generic
# ------------------------------------------------------------------------------
LLM_PROVIDER="openai"
LLM_API_KEY=""
LLM_MODEL="gpt-4o-mini"
LLM_BASE_URL="https://api.openai.com/v1"
LLM_TEMPERATURE=0.1
LLM_TIMEOUT=12.0
LLM_MAX_RETRIES=2
LLM_MAX_TOKENS=1500
LLM_CONFIDENCE_THRESHOLD=0.85
LLM_ENABLED=true
