# ==============================================================================
# NIRF Analytics Dashboard — Backend Environment Configuration (.env.example)
# ==============================================================================
# Duplicate this file to .env and configure your local settings.
# NEVER commit your real .env file or API keys to version control.

# Application Environment
ENVIRONMENT=development
DEBUG=True
PORT=8000
HOST=0.0.0.0
LOG_LEVEL=INFO

# CORS Allowed Origins (Comma-separated or JSON array)
BACKEND_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000

# Optional custom path to NIRF Master Dataset (Defaults to data/Processed/NIRF_Master_Dataset.csv)
# MASTER_DATASET_PATH=data/Processed/NIRF_Master_Dataset.csv

# ------------------------------------------------------------------------------
# External LLM Provider Configuration (Secondary AI Engine)
# Supports: openai, gemini, anthropic, openrouter, ollama, generic
# ------------------------------------------------------------------------------
LLM_PROVIDER=openai
LLM_API_KEY=your_api_key_here
LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=https://api.openai.com/v1
LLM_TEMPERATURE=0.1
LLM_TIMEOUT=12.0
LLM_MAX_RETRIES=2
LLM_MAX_TOKENS=1500
LLM_CONFIDENCE_THRESHOLD=0.85
LLM_ENABLED=True

# Examples for Alternative Providers:
# Google Gemini (OpenAI compatible endpoint):
# LLM_PROVIDER=gemini
# LLM_API_KEY=your_gemini_api_key
# LLM_MODEL=gemini-1.5-flash
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/

# Anthropic Claude:
# LLM_PROVIDER=anthropic
# LLM_API_KEY=your_anthropic_api_key
# LLM_MODEL=claude-3-5-sonnet-20241022

# Local Ollama:
# LLM_PROVIDER=ollama
# LLM_API_KEY=ollama
# LLM_MODEL=llama3.1
# LLM_BASE_URL=http://localhost:11434/v1

